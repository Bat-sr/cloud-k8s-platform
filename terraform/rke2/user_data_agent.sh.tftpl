#!/bin/bash
# Runs once at first boot on each WORKER. Installs RKE2 in "agent" mode and joins the master.
set -euxo pipefail

mkdir -p /etc/rancher/rke2
cat > /etc/rancher/rke2/config.yaml <<CONFIG
server: https://${server_ip}:9345
token: ${token}
node-name: ${node_name}
CONFIG

# Wait (up to ~15 minutes) until the master answers on its registration port
for i in $(seq 1 180); do
  if curl -sk --max-time 5 https://${server_ip}:9345/ping | grep -q pong; then
    break
  fi
  sleep 5
done

export INSTALL_RKE2_TYPE=agent
%{ if rke2_version != "" ~}
export INSTALL_RKE2_VERSION=${rke2_version}
%{ else ~}
export INSTALL_RKE2_CHANNEL=stable
%{ endif ~}
curl -sfL https://get.rke2.io | sh -

systemctl enable rke2-agent.service
systemctl start rke2-agent.service
